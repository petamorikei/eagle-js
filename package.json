{
  "name": "@petamorikei/eagle-js",
  "version": "0.3.4",
  "description": "Wrapper for Eagle API",
  "type": "module",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/main.ts",
    "dev:watch": "tsx watch src/main.ts",
    "clean": "rimraf dist",
    "typecheck": "tsc",
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "check": "biome check --write .",
    "lint": "biome ci .",
    "test": "vitest",
    "test:unit": "vitest run unit.test",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "eagle",
    "eagle-api",
    "api",
    "client",
    "wrapper",
    "typescript",
    "digital-asset-management"
  ],
  "author": "Petamori Kei",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/petamorikei/eagle-js.git"
  },
  "bugs": {
    "url": "https://github.com/petamorikei/eagle-js/issues"
  },
  "homepage": "https://github.com/petamorikei/eagle-js#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/node": "^26.6.6",
    "rimraf": "^6.1.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "dependencies": {
    "zod": "^4.6.7"
  }
}
